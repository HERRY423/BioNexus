{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/mcp.schema.json",
  "mcpServers": {
    "bionexus-local-mcp": {
      "type": "stdio",
      "command": "python",
      "args": [
        "${PLUGIN_ROOT}/scripts/local_mcp_server.py",
        "--audit-log",
        "${PLUGIN_ROOT}/.bionexus-audit/mcp-host-audit.jsonl"
      ],
      "cwd": "${PLUGIN_ROOT}"
    }
  }
}
