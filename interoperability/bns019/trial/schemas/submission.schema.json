{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:bionexus:bns019-interoperability-submission-schema:1",
  "type": "object",
  "required": ["schema", "trial_id", "submission_id", "implementation", "source", "standard", "execution", "result_artifact", "independence", "claim_boundary_acknowledged"],
  "properties": {
    "schema": {"const": "urn:bionexus:bns019-interoperability-submission:1"},
    "trial_id": {"const": "BNS019-INTEROP-2026-01"},
    "submission_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{2,127}$"},
    "implementation": {
      "type": "object",
      "required": ["id", "track", "language_or_host", "version"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "track": {"enum": ["independent_validator", "host_adapter", "workflow_adapter"]},
        "language_or_host": {"type": "string", "minLength": 1},
        "version": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    },
    "source": {
      "type": "object",
      "required": ["repository", "commit_sha", "license"],
      "properties": {
        "repository": {"type": "string", "format": "uri"},
        "commit_sha": {"type": "string", "pattern": "^[0-9a-f]{40,64}$"},
        "license": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    },
    "standard": {
      "type": "object",
      "required": ["id", "version", "release_digest_sha256"],
      "properties": {
        "id": {"const": "BNS-019"},
        "version": {"const": "0.1.0"},
        "release_digest_sha256": {"const": "b3164afe6ccd69dc9d7738c2ee58195ac65862701e29f9db1f98c12e1a97e934"}
      },
      "additionalProperties": false
    },
    "execution": {
      "type": "object",
      "required": ["command", "runtime", "operating_system", "executed_at"],
      "properties": {
        "command": {"type": "string", "minLength": 1},
        "runtime": {"type": "string", "minLength": 1},
        "operating_system": {"type": "string", "minLength": 1},
        "executed_at": {"type": "string", "format": "date-time"}
      },
      "additionalProperties": false
    },
    "result_artifact": {
      "type": "object",
      "required": ["path", "sha256"],
      "properties": {
        "path": {"type": "string", "pattern": "^results/[a-z0-9._/-]+\\.json$"},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      },
      "additionalProperties": false
    },
    "independence": {
      "type": "object",
      "required": ["independent_from_bionexus_maintainers", "conflicts_disclosed"],
      "properties": {
        "independent_from_bionexus_maintainers": {"type": "boolean"},
        "conflicts_disclosed": {"type": "string"}
      },
      "additionalProperties": false
    },
    "claim_boundary_acknowledged": {"const": true}
  },
  "additionalProperties": false
}
