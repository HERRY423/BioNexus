process {
    errorStrategy = 'terminate'
    maxRetries = 0

    withName: BNS019_SEMCONV {
        publishDir = [path: params.outdir, mode: 'copy', overwrite: false]
    }
}

manifest {
    name = 'bns019-interoperability-trial'
    description = 'nf-core-compatible BNS-019 registry transport and validation fixture'
    version = '0.1.0'
    nextflowVersion = '>=24.10.0'
}

params {
    outdir = 'results'
}
