{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:bionexus:scientific-semantic-conventions:registry-schema:1",
  "title": "BioNexus Scientific Semantic Convention Registry",
  "type": "object",
  "required": [
    "schema_version",
    "schema_url",
    "stability",
    "title",
    "attributes",
    "groups",
    "extension_namespace_pattern"
  ],
  "properties": {
    "$schema": {"type": "string"},
    "schema_version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "schema_url": {"type": "string", "minLength": 1},
    "stability": {"enum": ["development", "alpha", "beta", "release_candidate", "stable"]},
    "title": {"type": "string", "minLength": 1},
    "description": {"type": "string"},
    "attributes": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": {"pattern": "^[a-z][a-z0-9_]*(?:\\.[a-z][a-z0-9_]*)+$"},
      "additionalProperties": {"$ref": "#/$defs/attribute"}
    },
    "groups": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": {"pattern": "^[a-z][a-z0-9_]*(?:\\.[a-z][a-z0-9_]*)+$"},
      "additionalProperties": {"$ref": "#/$defs/group"}
    },
    "attribute_aliases": {"type": "object", "additionalProperties": {"type": "string"}},
    "value_aliases": {
      "type": "object",
      "additionalProperties": {"type": "object", "additionalProperties": {"type": "string"}}
    },
    "blocked_legacy_values": {
      "type": "object",
      "additionalProperties": {"type": "object", "additionalProperties": {"type": "string"}}
    },
    "extension_namespace_pattern": {"type": "string", "minLength": 1}
  },
  "$defs": {
    "stability": {"enum": ["development", "alpha", "beta", "release_candidate", "stable"]},
    "attribute": {
      "type": "object",
      "required": ["type", "cardinality", "stability", "brief", "values"],
      "properties": {
        "type": {"enum": ["string", "string_array"]},
        "cardinality": {"enum": ["one", "many"]},
        "stability": {"$ref": "#/$defs/stability"},
        "brief": {"type": "string", "minLength": 1},
        "note": {"type": "string"},
        "values": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        }
      },
      "additionalProperties": false
    },
    "group": {
      "type": "object",
      "required": ["type", "stability", "brief", "attributes"],
      "properties": {
        "type": {"enum": ["event", "entity"]},
        "stability": {"$ref": "#/$defs/stability"},
        "brief": {"type": "string", "minLength": 1},
        "attributes": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": {"enum": ["required", "recommended", "opt_in"]}
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
