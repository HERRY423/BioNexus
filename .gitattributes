# Default text files to LF
* text=auto eol=lf

# Preserve byte-exact CRLF for pre-signed cryptographic validation fixtures and datasets
validation/pseudobulk/studies/** text eol=crlf
validation/pseudobulk/independent/** text eol=crlf
data/flagship/** text eol=crlf

# Binary files
*.h5ad binary
*.h5 binary
*.whl binary
*.gz binary
*.tar.gz binary
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
