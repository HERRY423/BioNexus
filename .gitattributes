# Default text files to LF across Windows, Linux, macOS
* text=auto eol=lf

# Preserve byte-exact CRLF for pre-signed cryptographic validation study fixtures
validation/pseudobulk/studies/** text eol=crlf
validation/pseudobulk/studies/BN-PB-IV-004/PREREGISTRATION.json text eol=lf

# Binary files
*.h5ad binary
*.h5 binary
*.whl binary
*.gz binary
*.tar.gz binary
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
