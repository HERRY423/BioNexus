{"results":[{"entries":[{"dbId":"197604","stId":"R-HSA-197604","id":"R-HSA-197604","name":"<span class=\"highlighting\" >PDCD1</span>","type":"Protein","exactType":"ReferenceGeneProduct","species":["Homo sapiens"],"referenceName":"<span class=\"highlighting\" >PDCD1</span>","referenceIdentifier":"Q15116","compartmentNames":["plasma membrane"],"compartmentAccession":["0005886"],"isDisease":false,"hasReferenceEntity":true,"databaseName":"UniProt","referenceURL":"http://purl.uniprot.org/uniprot/Q15116","disease":false},{"dbId":"3211776","stId":"R-HSA-3211776","id":"R-HSA-3211776","name":"<span class=\"highlighting\" >CD274</span>","type":"Protein","exactType":"ReferenceGeneProduct","species":["Homo sapiens"],"referenceName":"<span class=\"highlighting\" >CD274</span>","referenceIdentifier":"Q9NZQ7","compartmentNames":["plasma membrane"],"compartmentAccession":["0005886"],"isDisease":false,"hasReferenceEntity":true,"databaseName":"UniProt","referenceURL":"http://purl.uniprot.org/uniprot/Q9NZQ7","disease":false},{"dbId":"9925063","stId":"R-HSA-9925063","id":"R-HSA-9925063","name":"<span class=\"highlighting\" >CD274</span>","type":"Protein","exactType":"ReferenceGeneProduct","species":["Homo sapiens"],"referenceName":"<span class=\"highlighting\" >CD274</span>","referenceIdentifier":"Q9NZQ7","compartmentNames":["cytosol"],"compartmentAccession":["0005829"],"isDisease":false,"hasReferenceEntity":true,"databaseName":"UniProt","referenceURL":"http://purl.uniprot.org/uniprot/Q9NZQ7","disease":false},{"dbId":"9930703","stId":"R-HSA-9930703","id":"R-HSA-9930703","name":"<span class=\"highlighting\" >CD274</span>","type":"Protein","exactType":"ReferenceGeneProduct","species":["Homo sapiens"],"referenceName":"<span class=\"highlighting\" >CD274</span>","referenceIdentifier":"Q9NZQ7","compartmentNames":["endoplasmic reticulum membrane"],"compartmentAccession":["0005789"],"isDisease":false,"hasReferenceEntity":true,"databaseName":"UniProt","referenceURL":"http://purl.uniprot.org/uniprot/Q9NZQ7","disease":false},{"dbId":"389736","stId":"R-HSA-389736","id":"R-HSA-389736","name":"p-Y223,Y248-<span class=\"highlighting\" >PDCD1</span>","type":"Protein","exactType":"ReferenceGeneProduct","species":["Homo sapiens"],"referenceName":"<span class=\"highlighting\" >PDCD1</span>","referenceIdentifier":"Q15116","compartmentNames":["plasma membrane"],"compartmentAccession":["0005886"],"isDisease":false,"hasReferenceEntity":true,"databaseName":"UniProt","referenceURL":"http://purl.uniprot.org/uniprot/Q15116","disease":false},{"dbId":"9931315","stId":"R-HSA-9931315","id":"R-HSA-9931315","name":"N-glycosylated <span class=\"highlighting\" >CD274</span>","type":"Protein","exactType":"ReferenceGeneProduct","species":["Homo sapiens"],"referenceName":"<span class=\"highlighting\" >CD274</span>","referenceIdentifier":"Q9NZQ7","compartmentNames":["Golgi membrane"],"compartmentAccession":["0000139"],"isDisease":false,"hasReferenceEntity":true,"databaseName":"UniProt","referenceURL":"http://purl.uniprot.org/uniprot/Q9NZQ7","disease":false},{"dbId":"9931256","stId":"R-HSA-9931256","id":"R-HSA-9931256","name":"N-glycosylated <span class=\"highlighting\" >CD274</span>","type":"Protein","exactType":"ReferenceGeneProduct","species":["Homo sapiens"],"referenceName":"<span class=\"highlighting\" >CD274</span>","referenceIdentifier":"Q9NZQ7","compartmentNames":["endoplasmic reticulum membrane"],"compartmentAccession":["0005789"],"isDisease":false,"hasReferenceEntity":true,"databaseName":"UniProt","referenceURL":"http://purl.uniprot.org/uniprot/Q9NZQ7","disease":false},{"dbId":"9931289","stId":"R-HSA-9931289","id":"R-HSA-9931289","name":"polyLacNac-Glycosylated <span class=\"highlighting\" >CD274</span>","type":"Protein","exactType":"ReferenceGeneProduct","species":["Homo sapiens"],"referenceName":"<span class=\"highlighting\" >CD274</span>","referenceIdentifier":"Q9NZQ7","compartmentNames":["Golgi membrane"],"compartmentAccession":["0000139"],"isDisease":false,"hasReferenceEntity":true,"databaseName":"UniProt","referenceURL":"http://purl.uniprot.org/uniprot/Q9NZQ7","disease":false},{"dbId":"9931435","stId":"R-HSA-9931435","id":"R-HSA-9931435","name":"K63polyUb-polyLacNac-Glycosylated <span class=\"highlighting\" >CD274</span>","type":"Protein","exactType":"ReferenceGeneProduct","species":["Homo sapiens"],"referenceName":"<span class=\"highlighting\" >CD274</span>","referenceIdentifier":"Q9NZQ7","compartmentNames":["Golgi membrane"],"compartmentAccession":["0000139"],"isDisease":false,"hasReferenceEntity":true,"databaseName":"UniProt","referenceURL":"http://purl.uniprot.org/uniprot/Q9NZQ7","disease":false},{"dbId":"9931307","stId":"R-HSA-9931307","id":"R-HSA-9931307","name":"K63polyUb-polyLacNac-Glycosylated <span class=\"highlighting\" >CD274</span>","type":"Protein","exactType":"ReferenceGeneProduct","species":["Homo sapiens"],"referenceName":"<span class=\"highlighting\" >CD274</span>","referenceIdentifier":"Q9NZQ7","compartmentNames":["plasma membrane"],"compartmentAccession":["0005886"],"isDisease":false,"hasReferenceEntity":true,"databaseName":"UniProt","referenceURL":"http://purl.uniprot.org/uniprot/Q9NZQ7","disease":false}],"typeName":"Protein","entriesCount":19,"rowCount":10},{"entries":[{"dbId":"9679421","stId":"R-HSA-9679421","id":"R-HSA-9679421","name":"<span class=\"highlighting\" >PDCD1</span> binds <span class=\"highlighting\" >PDCD1</span> inhibitors","type":"Reaction","exactType":"binding","species":["Homo sapiens"],"summation":"Programmed cell death protein 1 (<span class=\"highlighting\" >PDCD1</span>, PD-1) is an immune checkpoint protein that guards against autoimmunity. It is a cell-surface protein expressed on T cells and pro-B cells. <span class=\"highlighting\" >PDCD1</span> inhibitors are a group of checkpoint inhibitor drugs that block the activity of <span class=\"highlighting\" >PDCD1</span> present on the surface of these cells. They are mainly used in the treatment of various cancers.<br><br>Cemiplimab (Libtayo, REGN-2810) is the first FDA approval of a drug specifically for the treatment of advanced cutaneous squamous cell carcinoma (CSCC) (Burova et al. 2017, Migden et al. 2018). Nivolumab (Opdivo) is a fully human IgG4 antibody targeting the immune checkpoint programmed death receptor 1 (PD1) (Tan et al. 2017) indicated for many cancers (Yaghoubi et al. 2019). Camrelizumab (SHR-1210) is a fully human anti-programmed cell death 1 (PD1) monoclonal antibody being developed as an immuno-oncology therapeutic (Markham & Keam 2019).<br><br>Clinical efficacy of camrelizumab plus thymosin in patients with COVID-19 is evaluated in clinical trial NCT04268537.","compartmentNames":["plasma membrane","extracellular region"],"compartmentAccession":["0005886","0005576"],"isDisease":false,"hasReferenceEntity":false,"disease":false},{"dbId":"9929353","stId":"R-HSA-9929353","id":"R-HSA-9929353","name":"Deubiquitination of <span class=\"highlighting\" >CD274</span>","type":"Reaction","exactType":"transition","species":["Homo sapiens"],"summation":"COP9 signalosome 5 (CSN5) poses deubiquitination activity and is known to regulate the SCF (Skp1- cullinF-box)-containing complexes. In the study by Lim et al., 2016, CSN5 induced by TNF-alpha signalling was shown to augment PD-L1 (<span class=\"highlighting\" >CD274</span>) stability by deubiquitinating PD-L1.","compartmentNames":["cytosol"],"compartmentAccession":["0005829"],"isDisease":false,"hasReferenceEntity":false,"disease":false},{"dbId":"9925190","stId":"R-HSA-9925190","id":"R-HSA-9925190","name":"<span class=\"highlighting\" >CD274</span> translation","type":"Reaction","exactType":"uncertain","species":["Homo sapiens"],"summation":"<span class=\"highlighting\" >CD274</span> (PD-L1) translation is a critical step in the regulation of PD-L1 expression. At translational level, PD-L1 is regulated by multiple factors including microRNAs (miRNAs). miRNA can directly regulate translation by targeting 3’ untranslated region (3’UTR) of PD-L1 mRNA and regualtes its expression (Skafi et al. 2020, Wang et al., 2020). Under normal physiological conditions, these miRNAs prevent the over-expression of PDL1, thus helps prevent immune tolerance and keeps autoimmune reactions under control. Under disease conditions like cancers, dysregulation of miRNA leads to increased PDL-1 expression and helps cancer cells to evade immune response by T cells (Danbaran et al., 2020, Kao et al., 2017, Grenda et al., 2017).","compartmentNames":["cytosol"],"compartmentAccession":["0005829"],"isDisease":false,"hasReferenceEntity":false,"disease":false},{"dbId":"9909623","stId":"R-HSA-9909623","id":"R-HSA-9909623","name":"<span class=\"highlighting\" >CD274</span> Transcription","type":"Reaction","exactType":"omitted","species":["Homo sapiens"],"summation":"The transcriptional regulation of <span class=\"highlighting\" >CD274</span> (PD-L1/programmed death-ligand 1) is crucial in cancer biology, enabling tumor cells to evade immune detection. PD-L1 expression is tightly controlled by various transcription factors and signalling pathways responding to both intrinsic cellular signals and extrinsic environmental perturbations. It is regulated transcriptionally by multiple mechanisms, including epigenetic modifications (EZH2, DNMTs, MLLs) and transcription factors (STAT3, STAT1, IRF1, MYC, HIF, and others) activated by various upstream signalling pathways. The regulation of PD-L1 is a complex interplay of oncogenic signalling pathways, cytokine responses, epigenetic modifications, specific transcription factors, the tumor microenvironment, and non-coding RNAs. This multifaceted regulation finely tunes PD-L1 expression to promote immune evasion in cancer, making it a critical target for cancer immunotherapy (Zhou et al., 2023, Cha et al.,2019, Yamaguchi et al.,2022, Ju et al., 2020).","compartmentNames":["nucleoplasm"],"compartmentAccession":["0005654"],"isDisease":false,"hasReferenceEntity":false,"disease":false},{"dbId":"9931409","stId":"R-HSA-9931409","id":"R-HSA-9931409","name":"NEK2 phosphorylates <span class=\"highlighting\" >CD274</span>","type":"Reaction","exactType":"transition","species":["Homo sapiens"],"summation":"Never in mitosis gene A-related kinase 2 (NEK2) phosphorylates PD-L1 (<span class=\"highlighting\" >CD274</span>) at T194 and T210 residues and maintain its stability by preventing ubiquitin-proteasome pathway-mediated degradation of PD-L1 in the ER lumen. A NEK binding motif (F/LXXS/T) was identified in the glycosylation-rich region of PD-L1 (Zhang et al, 2021).","compartmentNames":["endoplasmic reticulum membrane"],"compartmentAccession":["0005789"],"isDisease":false,"hasReferenceEntity":false,"disease":false},{"dbId":"9931418","stId":"R-HSA-9931418","id":"R-HSA-9931418","name":"CK2 phosphorylates <span class=\"highlighting\" >CD274</span>","type":"Reaction","exactType":"transition","species":["Homo sapiens"],"summation":"Casein Kinase 2 (CK2) phosphorylates and stabilizes PD-L1 (<span class=\"highlighting\" >CD274</span>) in dendritic and cancer cells. CK2 phosphorylates PD-L1 at Thr285 (T285) and Thr290 (T290), thus disrupting PD-L1 binding with the speckle-type POZ protein, an adaptor protein of the cullin-3 (CUL3) ubiquitin E3 ubiquitin ligase complex SPOP:CUL3:RBX1, protecting PD-L1 from SPOP:CUL3:RBX1-mediated proteasomal degradation (Zhao et al., 2022).","compartmentNames":["endoplasmic reticulum membrane","cytosol"],"compartmentAccession":["0005789","0005829"],"isDisease":false,"hasReferenceEntity":false,"disease":false},{"dbId":"9931292","stId":"R-HSA-9931292","id":"R-HSA-9931292","name":"AMPK phosphorylates <span class=\"highlighting\" >CD274</span>","type":"Reaction","exactType":"transition","species":["Homo sapiens"],"summation":"AMP-activated protein kinase (AMPK), activated in response to metformin, directly binds with PD-L1 (<span class=\"highlighting\" >CD274</span>) and phosphorylates S195 of PD-L1. This phosphorylation induces abnormal PD-L1 glycosylation (abnormal mannose trimming), resulting in its endoplasmic reticulum (ER) accumulation and ER-associated protein degradation (ERAD) (Cha et al., 2018, Dai et al., 2021). In addition to Ser195, AMPK phosphorylates Ser283 on PD-L1, which promotes its lysosome-mediated degradation (Dai et al., 2021).","compartmentNames":["endoplasmic reticulum membrane","endoplasmic reticulum lumen"],"compartmentAccession":["0005789","0005788"],"isDisease":false,"hasReferenceEntity":false,"disease":false},{"dbId":"9929360","stId":"R-HSA-9929360","id":"R-HSA-9929360","name":"GSK3B phosphorylates <span class=\"highlighting\" >CD274</span>","type":"Reaction","exactType":"transition","species":["Homo sapiens"],"summation":"Glycogen synthase kinase 3β (GSK3β) is a serine/threonine protein kinase that interacts with PD-L1 (<span class=\"highlighting\" >CD274</span>) and induces phosphorylation-dependent proteasome degradation of PD-L1 by β-TrCP-SCF (BTRC-SCF) complex (Li et al., 2016, Schulz et al., 2019). GSK3β induced phosphorylation of non-glycosylated PD-L1 at T180 and S184 sites which also antagonizes the glycosylation of PD-L1 at N192, N200 and N219 sites. Glycosylation of PD-L1 also hinder the phsophorylation of PD-L1 by GSK3B competitively (Li et al., 2016). NEK2 negatively regulate this process by phosphorylating PD-L1 at T194 and T210 residue (Zhang et al., 2021).","compartmentNames":["endoplasmic reticulum membrane"],"compartmentAccession":["0005789"],"isDisease":false,"hasReferenceEntity":false,"disease":false},{"dbId":"9929484","stId":"R-HSA-9929484","id":"R-HSA-9929484","name":"SPOP:CUL3:RBX1 binds to <span class=\"highlighting\" >CD274</span>","type":"Reaction","exactType":"binding","species":["Homo sapiens"],"summation":"The SPOP:CUL3:RBX1 E3 ubiquitin ligase complex regulates the ubiquitination and degradation of PD-L1(<span class=\"highlighting\" >CD274</span>) protein. It catalyzes the polyubiquitination of PD-L1 and tags it for the proteasomal degradation. This interaction is negatively regulated by CCND1:CDK4-induced phosphorylation of SPOP and its sequestration by 14-3-3 protein gamma (Zhang et al., 2018, Dong et al., 2022). This binding is also negatively regulated by CK2-mediated phosphorylation of PD-L1 (Zhao et al.,2022).","compartmentNames":["cytosol","endoplasmic reticulum membrane"],"compartmentAccession":["0005829","0005789"],"isDisease":false,"hasReferenceEntity":false,"disease":false},{"dbId":"9931430","stId":"R-HSA-9931430","id":"R-HSA-9931430","name":"MIB2-mediated K63-ubiquitination of <span class=\"highlighting\" >CD274</span>","type":"Reaction","exactType":"transition","species":["Homo sapiens"],"summation":"Mind bomb homolog 2 (MIB2) is an E3 ubiquitin ligase catalyzing nonproteolytic ubiquitination of PD-L1 (<span class=\"highlighting\" >CD274</span>) required for the plasma membrane translocation of PD-L1. MIB2 catalyzes nonproteolytic K63-linked polyubiquitination of PD-L1, facilitating PD-L1 trafficking through exocytosis from the TGN (trans-Golgi network) to the plasma membrane (Yu et al., 2023).","compartmentNames":["Golgi membrane"],"compartmentAccession":["0000139"],"isDisease":false,"hasReferenceEntity":false,"disease":false}],"typeName":"Reaction","entriesCount":60,"rowCount":10},{"entries":[{"dbId":"Q9NZQ7-1","stId":"Q9NZQ7-1","id":"Q9NZQ7-1","name":"<span class=\"highlighting\" >CD274</span>","type":"Interactor","exactType":"Interactor","species":["Homo sapiens"],"referenceIdentifier":"Q9NZQ7-1","databaseName":"UniProt","referenceURL":"https://www.uniprot.org/uniprotkb/Q9NZQ7-1/entry"}],"typeName":"Interactor","entriesCount":1,"rowCount":1},{"entries":[{"dbId":"9909617","stId":"R-HSA-9909617","id":"R-HSA-9909617","name":"<span class=\"highlighting\" >CD274</span> mRNA","type":"RNA Sequence","exactType":"ReferenceRNASequence","species":["Homo sapiens"],"referenceIdentifier":"ENSEMBL:ENST00000381573.3","compartmentNames":["cytosol"],"compartmentAccession":["0005829"],"isDisease":false,"hasReferenceEntity":true,"databaseName":"ENSEMBL","referenceURL":"https://www.ensembl.org/id/ENST00000381573.3","disease":false}],"typeName":"RNA Sequence","entriesCount":1,"rowCount":1},{"entries":[{"dbId":"9701419","stId":"R-HSA-9701419","id":"R-HSA-9701419","name":"<span class=\"highlighting\" >CD274</span> gene","type":"DNA Sequence","exactType":"ReferenceDNASequence","species":["Homo sapiens"],"referenceIdentifier":"ENSEMBL:ENSG00000120217","compartmentNames":["nucleoplasm"],"compartmentAccession":["0005654"],"isDisease":false,"hasReferenceEntity":true,"databaseName":"ENSEMBL","referenceURL":"https://www.ensembl.org/id/ENSG00000120217","disease":false}],"typeName":"DNA Sequence","entriesCount":1,"rowCount":1},{"entries":[{"dbId":"9909633","stId":"R-HSA-9909633","id":"R-HSA-9909633","name":"<span class=\"highlighting\" >CD274</span> gene chromatin","type":"Complex","exactType":"Complex","species":["Homo sapiens"],"compartmentNames":["nucleoplasm"],"compartmentAccession":["0005654"],"isDisease":false,"hasReferenceEntity":false,"disease":false},{"dbId":"9925071","stId":"R-HSA-9925071","id":"R-HSA-9925071","name":"<span class=\"highlighting\" >CD274</span> mRNA:miR140 RISC","type":"Complex","exactType":"Complex","species":["Homo sapiens"],"compartmentNames":["cytosol"],"compartmentAccession":["0005829"],"isDisease":false,"hasReferenceEntity":false,"disease":false},{"dbId":"9925118","stId":"R-HSA-9925118","id":"R-HSA-9925118","name":"<span class=\"highlighting\" >CD274</span> mRNA:miR424 RISC","type":"Complex","exactType":"Complex","species":["Homo sapiens"],"compartmentNames":["cytosol"],"compartmentAccession":["0005829"],"isDisease":false,"hasReferenceEntity":false,"disease":false},{"dbId":"9925282","stId":"R-HSA-9925282","id":"R-HSA-9925282","name":"<span class=\"highlighting\" >CD274</span> mRNA:miR-93 RISC","type":"Complex","exactType":"Complex","species":["Homo sapiens"],"compartmentNames":["cytosol"],"compartmentAccession":["0005829"],"isDisease":false,"hasReferenceEntity":false,"disease":false},{"dbId":"9925250","stId":"R-HSA-9925250","id":"R-HSA-9925250","name":"<span class=\"highlighting\" >CD274</span> mRNA:miR-34 RISC","type":"Complex","exactType":"Complex","species":["Homo sapiens"],"compartmentNames":["cytosol"],"compartmentAccession":["0005829"],"isDisease":false,"hasReferenceEntity":false,"disease":false},{"dbId":"9924949","stId":"R-HSA-9924949","id":"R-HSA-9924949","name":"<span class=\"highlighting\" >CD274</span> mRNA:miR-340 RISC","type":"Complex","exactType":"Complex","species":["Homo sapiens"],"compartmentNames":["cytosol"],"compartmentAccession":["0005829"],"isDisease":false,"hasReferenceEntity":false,"disease":false},{"dbId":"9925260","stId":"R-HSA-9925260","id":"R-HSA-9925260","name":"<span class=\"highlighting\" >CD274</span> mRNA:miR-152 RISC","type":"Complex","exactType":"Complex","species":["Homo sapiens"],"compartmentNames":["cytosol"],"compartmentAccession":["0005829"],"isDisease":false,"hasReferenceEntity":false,"disease":false},{"dbId":"9925305","stId":"R-HSA-9925305","id":"R-HSA-9925305","name":"<span class=\"highlighting\" >CD274</span> mRNA:miR-429 RISC","type":"Complex","exactType":"Complex","species":["Homo sapiens"],"compartmentNames":["cytosol"],"compartmentAccession":["0005829"],"isDisease":false,"hasReferenceEntity":false,"disease":false},{"dbId":"9925273","stId":"R-HSA-9925273","id":"R-HSA-9925273","name":"<span class=\"highlighting\" >CD274</span> mRNA:miR-142-5p RISC","type":"Complex","exactType":"Complex","species":["Homo sapiens"],"compartmentNames":["cytosol"],"compartmentAccession":["0005829"],"isDisease":false,"hasReferenceEntity":false,"disease":false},{"dbId":"9925221","stId":"R-HSA-9925221","id":"R-HSA-9925221","name":"<span class=\"highlighting\" >CD274</span> mRNA:miR-148a-3p RISC","type":"Complex","exactType":"Complex","species":["Homo sapiens"],"compartmentNames":["cytosol"],"compartmentAccession":["0005829"],"isDisease":false,"hasReferenceEntity":false,"disease":false}],"typeName":"Complex","entriesCount":34,"rowCount":10},{"entries":[{"dbId":"9909648","stId":"R-HSA-9909648","id":"R-HSA-9909648","name":"Regulation of PD-L1(<span class=\"highlighting\" >CD274</span>) expression","type":"Pathway","exactType":"Pathway","species":["Homo sapiens"],"summation":"The PD-L1(<span class=\"highlighting\" >CD274</span>)/PD1 pathways play a pivotal role in the regulation of normal T cell function as well in diseases like Cancer. It is a major co-inhibitory checkpoint signalling that regulates T cell activities and maintains immune homeostasis thus preventing autoimmunity in normal physiology (Cha et al., 2019) and this same machinery is hijacked in disease like cancer to evade T-cells immunity against cancer cells (Ju et al., 2020, Zhou et al., 2023). Under normal physiological conditions, PDL-1 (<span class=\"highlighting\" >CD274</span>) binds with its receptor PD1 and inhibits TCR and costimulatory signalling, thus inhibiting T cell activation (Arasanz et al. 2017, Riley et al.,2009, Sharpe et al., 2018). This regulation helps in the maintenance of immune tolerance. PDL1 (<span class=\"highlighting\" >CD274</span>) is normally expressed by antigen presenting cells APCs but it's also found to be expressed by non-immune cells like cancer cells (Cha et al., 2019, Chen et al., 2016. Expression of PDL1 is highly up regulated in cancers to evade the immune response by T cells thus making it a critical target for cancer treatment which leads to rapid FDA approval of drugs targeting PDL1/PD1 pathway (Ju et al., 2020, Yamaguchi et al. 2023, Wu et al.,2021). Expression of PDL1 is tightly controlled at epigenetics, transcriptional, translational and post translational level in normal condition but cancer cells utilise this regulation to induce PDL1 expression on its surface. (Cha et al., 2019, Ju et al, 2020, Zhou et al, 2023).","isDisease":false,"hasReferenceEntity":false,"hasEHLD":false,"disease":false},{"dbId":"9909620","stId":"R-HSA-9909620","id":"R-HSA-9909620","name":"Regulation of PD-L1(<span class=\"highlighting\" >CD274</span>) translation","type":"Pathway","exactType":"Pathway","species":["Homo sapiens"],"summation":"The synthesis of PD-L1 (<span class=\"highlighting\" >CD274</span>) protein from its mRNA under various physiological and pathological conditions is tightly regulated by microRNAs (miRNAs) that bind to the 3' untranslated region (3' UTR) of PD-L1 mRNA, influencing its stability and translation efficiency (Skafi et al., 2020, Wang et al., 2017). For example, miR 34a and miR 200 directly target PD L1 mRNA, leading to decreased protein synthesis, which is important in controlling autoimmune response in normal physiological conditions and immune escape mechanisms in cancer (Danbaran et al., 2020, Kao et al., 2017, Grenda et al., 2017). The translation regulation of PD-L1 is a critical area of research, particularly in the context of cancer and other diseases where PD-L1 is implicated in pathology (Zhou et al., 2023, Ashrafizadeh et al., 2020).","isDisease":false,"hasReferenceEntity":false,"hasEHLD":false,"disease":false},{"dbId":"9909649","stId":"R-HSA-9909649","id":"R-HSA-9909649","name":"Regulation of PD-L1(<span class=\"highlighting\" >CD274</span>) transcription","type":"Pathway","exactType":"Pathway","species":["Homo sapiens"],"summation":"The transcriptional regulation of <span class=\"highlighting\" >CD274</span> (PD-L1/ programmed death-ligand 1) plays a critical role in the regulation of normal T cell function in normal physiological condition where it provides immune homeostasis. The expression of PD-L1 is tightly controlled by various transcription factors and signalling pathways, which respond to both intrinsic cellular signals and extrinsic environmental perturbations. PD-L1 is regulated transcriptionally by multiple mechanism like epigenetic modifications (EZH2, DNMTs, MLLs), transcription factors (STAT3. STAT1, IRF1, MYC, HIF and ither) which get activated in response to multiple upstream signalling pathways.  The transcriptional regulation of PD-L1 is a complex interplay of oncogenic signalling pathways, cytokine responses, epigenetic modifications, specific transcription factors, the tumour microenvironment, and non-coding RNAs. This multifaceted regulation ensures that PD-L1 expression can be finely tuned to promote immunotolerance in normal condition as well as immune evasion in cancer, making it a critical target for cancer immunotherapy (Zhou et al.,2023, Cha et al.,2019, Yamaguchi et al.,2022, Ju et al.,2020)","isDisease":false,"hasReferenceEntity":false,"hasEHLD":false,"disease":false},{"dbId":"9929491","stId":"R-HSA-9929491","id":"R-HSA-9929491","name":"SPOP-mediated proteasomal degradation of PD-L1(<span class=\"highlighting\" >CD274</span>)","type":"Pathway","exactType":"Pathway","species":["Homo sapiens"],"summation":"SPOP:CUL3:RBX1 E3 ubiquitin ligase complex regulates the ubiquitination and degradation of PD-L1(<span class=\"highlighting\" >CD274</span>) protein. This is negatively regulated by Cyclin D:CDK4 complex which phosphorylates SPOP on Ser-6 (S6) and facilitates its sequestration by 14-3-3 protein gamma (Zhang et al., 2018), thus inhibiting SPOP-mediated recruitment in the E3 ubiquitin ligase complex. \n","isDisease":false,"hasReferenceEntity":false,"hasEHLD":false,"disease":false},{"dbId":"9931295","stId":"R-HSA-9931295","id":"R-HSA-9931295","name":"PD-L1(<span class=\"highlighting\" >CD274</span>) glycosylation and translocation to plasma membrane","type":"Pathway","exactType":"Pathway","species":["Homo sapiens"],"summation":"PD-L1 (<span class=\"highlighting\" >CD274</span>) glycosylation plays a critical role in determining the protein function and stability. PD-L1 is N-glycosylated at N192, N200 and N219 by the OST complex in the ER lumen. This process is important for PD-L1 stability and inhibits its targeting for proteasomal degradation by GSK3B (Li et al., 2016). Also, JAK1 activated by IL6 pathway positively regulates the glycosylation process by aiding in the process of recruiting endoplasmic reticulum-associated N-glycosyltransferase STT3A (part of the OST complex) to catalyse PD-L1 glycosylation (Chan et al., 2019). PD-L1 is phosphorylated by IL6-activated JAK1 at Tyr112 (Y112). This process aids in stabilizing the PD-L1 protein. PD-L1, once glycosylated in the ER lumen, get translocated to the Golgi complex for further glycosylation by B3GNT3 (Li et al., 2018) and K63-ubiquitination by MIB2 (Yu et al., 2023). Post Golgi, PD-L1 gets transported to the plasma membrane where it can bind with its receptor and induce immune tolerance.","isDisease":false,"hasReferenceEntity":false,"hasEHLD":false,"disease":false},{"dbId":"9909615","stId":"R-HSA-9909615","id":"R-HSA-9909615","name":"Regulation of PD-L1(<span class=\"highlighting\" >CD274</span>) Post-translational modification","type":"Pathway","exactType":"Pathway","species":["Homo sapiens"],"summation":"Post-translational modification (PTM) of <span class=\"highlighting\" >CD274</span> (PD-L1) is a crucial regulatory mechanism that significantly impacts its stability, surface presentation and interaction with its receptor PD-1, thus modulating normal immune function and immune response in cancers by influencing tumor immune evasion (Yu et al., 2021, Hsu et al., 2018, Feng et al., 2023). PTMs of PD-L1 includes glycosylation (Li et al., 2018), ubiquitination/de-ubiquitination (Schulz et al., 2019, Zhang et al., 2021), phosphorylation (Li et al., 2018, Cha et al., 2018, Zhao et al, 2022, Zhang et al., 2018). These post-translational modifications collectively modulate the effectiveness of PD-L1 in immune checkpoint pathways and have significant implications for the development of immune therapies targeting PD-L1 in various diseases, including cancer. These processes reveal potential therapeutic targets for enhancing the efficacy of PD-L1 inhibitors by manipulating its post-translational regulation (Ming et al.,2021, Yamaguchi et al.,2022)","isDisease":false,"hasReferenceEntity":false,"hasEHLD":false,"disease":false},{"dbId":"9929356","stId":"R-HSA-9929356","id":"R-HSA-9929356","name":"GSK3B-mediated proteasomal degradation of PD-L1(<span class=\"highlighting\" >CD274</span>)","type":"Pathway","exactType":"Pathway","species":["Homo sapiens"],"summation":"Post-translational modifications (PTMs) of PD-L1 (<span class=\"highlighting\" >CD274</span>) play an important regulatory role in modulating immune tolerance in normal physiology.  The same mechanism is hijacked by cancer cells to enable immune evasion (Hsu et al., 2018, Dai et al., 2022, Yu et al., 2021). PD-L1 protein levels are tightly controlled by multiple mechanisms such as phosphorylation, glycosylation, ubiquitination, etc. (Feng et al., 2023). GSK3B is a serine-threonine kinase known to be regulated by multiple growth factor signalling pathways like EGFR, WNT, etc. GSK3B is constitutively active and phosphorylation by upstream pathways inactivates its kinase activity. GSK3B regulates PD-L1 protein stability and glycosylation. GSK3B phosphorylation of PD-L1 at T180 and S184 induces proteasomal degradation of PD-L1 and inhibits its glycosylation. GSK3B-induced phosphorylation facilitates binding of PD-L1 with β-TrCP (BTRC), a substrate recognition subunit of the SCF E3 ubiquitin ligase complex, which promotes PD-L1 ubiquitination and routes it for proteasomal degradation (Li et al, 2016, Schulz et al., 2019). Moreover, MET phosphorylates GSK3B at tyrosine 56, resulting in GSK3B activation and promotion of PD-L1 degradation (Li etal, 2019).","isDisease":false,"hasReferenceEntity":false,"hasEHLD":false,"disease":false},{"dbId":"9931269","stId":"R-HSA-9931269","id":"R-HSA-9931269","name":"AMPK-induced ERAD and lysosome mediated degradation of PD-L1(<span class=\"highlighting\" >CD274</span>)","type":"Pathway","exactType":"Pathway","species":["Homo sapiens"],"summation":"Adenosine monophosphate (AMP)-activated protein kinase (AMPK) is the main sensor of energy stress, playing a part in adaptive responses to falling energy levels. AMPK is a heterotrimeric protein complex, comprised of a catalytic α subunit (PRKAA1,PRKAA2), a β subunit (PRKAB1, PRKAB2), and a γ subunits (PRKAG1, PRKAG2, PRKAG3). During energy deprivation, cellular levels of AMP are increased while ATP levels decline, leading to AMPK activation because of allosteric changes. (Dai et al., 2021). Activated AMPK phosphorylates PD-L1 (<span class=\"highlighting\" >CD274</span>) at S195 which leads to abnormal glycosylation due to improper mannose trimming, thus leading to endoplasmic reticulum (ER) accumulation of PD-L1 and activation of ER-associated protein degradation (ERAD) pathway for the degradation of abnormally glycosylated PD-L1 (Cha et al., 2018). AMPK promotes not only ERAD-mediated but also lysosome-mediated degradation of PD-L1. Mechanistically, activated AMPK phosphorylates a specific serine residue (Ser283) on PD-L1, which disrupts its interaction with CMTM4 and consequently facilitates PD-L1 degradation via the lysosomal pathway (Dai et al., 2021).","isDisease":false,"hasReferenceEntity":false,"hasEHLD":false,"disease":false}],"typeName":"Pathway","entriesCount":8,"rowCount":8},{"entries":[{"dbId":"014017","stId":"R-ICO-014017","id":"R-ICO-014017","name":"<span class=\"highlighting\" >PDCD1</span>","type":"Icon","exactType":"Icon","species":["Homo sapiens"],"summation":"Programmed cell death protein 1","hasReferenceEntity":false,"hasEHLD":false,"iconName":"PDCD1","iconCategories":["protein","receptor"],"iconCuratorName":"Thawfeek Varusai","iconCuratorOrcidId":"0000-0002-7864-5971","iconDesignerName":"Cristoffer Sevilla","iconDesignerUrl":"https://graphsolutions.co.uk","iconReferences":["Q15116","UNIPROT:Q15116"],"iconPhysicalEntities":[{"stId":"R-HSA-389736","type":"ReferenceGeneProduct","name":"p-Y223,Y248-PDCD1","compartments":"plasma membrane","displayName":"p-Y223,Y248-PDCD1 [plasma membrane]"},{"stId":"uniprot:Q15116","type":"ReferenceGeneProduct","name":"PDCD1","compartments":"null","displayName":"PDCD1 [null]"},{"stId":"R-HSA-197604","type":"ReferenceGeneProduct","name":"PDCD1","compartments":"plasma membrane","displayName":"PDCD1 [plasma membrane]"}],"iconEhlds":["R-HSA-388841"],"icon":true},{"dbId":"014014","stId":"R-ICO-014014","id":"R-ICO-014014","name":"detailed <span class=\"highlighting\" >CD274</span>","type":"Icon","exactType":"Icon","species":["Homo sapiens"],"summation":"Programmed cell death 1 ligand 1","hasReferenceEntity":false,"hasEHLD":false,"iconName":"detailed CD274","iconCategories":["protein","receptor"],"iconCuratorName":"Thawfeek Varusai","iconCuratorOrcidId":"0000-0002-7864-5971","iconDesignerName":"Cristoffer Sevilla","iconDesignerUrl":"https://graphsolutions.co.uk","iconReferences":["Q9NZQ7","UNIPROT:Q9NZQ7"],"iconPhysicalEntities":[{"stId":"R-HSA-9925063","type":"ReferenceGeneProduct","name":"CD274","compartments":"cytosol","displayName":"CD274 [cytosol]"},{"stId":"R-HSA-9930703","type":"ReferenceGeneProduct","name":"CD274","compartments":"endoplasmic reticulum membrane","displayName":"CD274 [endoplasmic reticulum membrane]"},{"stId":"uniprot:Q9NZQ7","type":"ReferenceGeneProduct","name":"CD274","compartments":"null","displayName":"CD274 [null]"},{"stId":"R-HSA-3211776","type":"ReferenceGeneProduct","name":"CD274","compartments":"plasma membrane","displayName":"CD274 [plasma membrane]"},{"stId":"R-HSA-9931435","type":"ReferenceGeneProduct","name":"K63polyUb-polyLacNac-Glycosylated CD274","compartments":"Golgi membrane","displayName":"K63polyUb-polyLacNac-Glycosylated CD274 [Golgi membrane]"},{"stId":"R-HSA-9931307","type":"ReferenceGeneProduct","name":"K63polyUb-polyLacNac-Glycosylated CD274","compartments":"plasma membrane","displayName":"K63polyUb-polyLacNac-Glycosylated CD274 [plasma membrane]"},{"stId":"R-HSA-9931256","type":"ReferenceGeneProduct","name":"N-glycosylated CD274","compartments":"endoplasmic reticulum membrane","displayName":"N-glycosylated CD274 [endoplasmic reticulum membrane]"},{"stId":"R-HSA-9931315","type":"ReferenceGeneProduct","name":"N-glycosylated CD274","compartments":"Golgi membrane","displayName":"N-glycosylated CD274 [Golgi membrane]"},{"stId":"R-HSA-9936160","type":"ReferenceGeneProduct","name":"p-S184,T180-CD274","compartments":"cytosol","displayName":"p-S184,T180-CD274 [cytosol]"},{"stId":"R-HSA-9929349","type":"ReferenceGeneProduct","name":"p-S184,T180-CD274","compartments":"endoplasmic reticulum membrane","displayName":"p-S184,T180-CD274 [endoplasmic reticulum membrane]"},{"stId":"R-HSA-9931259","type":"ReferenceGeneProduct","name":"p-S195-CD274","compartments":"cytosol","displayName":"p-S195-CD274 [cytosol]"},{"stId":"R-HSA-9931301","type":"ReferenceGeneProduct","name":"p-S195-CD274","compartments":"endoplasmic reticulum membrane","displayName":"p-S195-CD274 [endoplasmic reticulum membrane]"},{"stId":"R-HSA-9931399","type":"ReferenceGeneProduct","name":"p-T194,T210-CD274","compartments":"endoplasmic reticulum membrane","displayName":"p-T194,T210-CD274 [endoplasmic reticulum membrane]"},{"stId":"R-HSA-9931388","type":"ReferenceGeneProduct","name":"p-T285,T290-CD274","compartments":"endoplasmic reticulum membrane","displayName":"p-T285,T290-CD274 [endoplasmic reticulum membrane]"},{"stId":"R-HSA-9931296","type":"ReferenceGeneProduct","name":"p-Y112-CD274","compartments":"endoplasmic reticulum membrane","displayName":"p-Y112-CD274 [endoplasmic reticulum membrane]"},{"stId":"R-HSA-9931289","type":"ReferenceGeneProduct","name":"polyLacNac-Glycosylated CD274","compartments":"Golgi membrane","displayName":"polyLacNac-Glycosylated CD274 [Golgi membrane]"}],"iconEhlds":["R-HSA-388841"],"icon":true},{"dbId":"013972","stId":"R-ICO-013972","id":"R-ICO-013972","name":"detailed PDCD1LG2","type":"Icon","exactType":"Icon","species":["Homo sapiens"],"summation":"Programmed cell death 1 ligand 2","hasReferenceEntity":false,"hasEHLD":false,"iconName":"detailed PDCD1LG2","iconCategories":["protein","receptor"],"iconCuratorName":"Thawfeek Varusai","iconCuratorOrcidId":"0000-0002-7864-5971","iconDesignerName":"Cristoffer Sevilla","iconDesignerUrl":"https://graphsolutions.co.uk","iconReferences":["Q9BQ51","UNIPROT:Q9BQ51"],"iconPhysicalEntities":[{"stId":"uniprot:Q9BQ51","type":"ReferenceGeneProduct","name":"PDCD1LG2","compartments":"null","displayName":"PDCD1LG2 [null]"},{"stId":"R-HSA-3211774","type":"ReferenceGeneProduct","name":"PDCD1LG2","compartments":"plasma membrane","displayName":"PDCD1LG2 [plasma membrane]"}],"iconEhlds":["R-HSA-388841"],"icon":true}],"typeName":"Icon","entriesCount":3,"rowCount":3}],"rowCount":44,"numberOfGroups":8,"numberOfMatches":127}