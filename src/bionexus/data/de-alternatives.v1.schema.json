{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$defs": {
    "ref": {
      "type": "object",
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      },
      "required": [
        "path",
        "sha256"
      ],
      "additionalProperties": false
    },
    "analysis_spec": {
      "type": "object",
      "properties": {
        "method": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "normalization": {
          "type": "string",
          "minLength": 1
        },
        "test": {
          "type": "string",
          "minLength": 1
        },
        "p_adjustment": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "method",
        "version",
        "normalization",
        "test",
        "p_adjustment"
      ],
      "additionalProperties": false
    },
    "specification": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "spec_id": {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,79}$"
            },
            "rationale": {
              "type": "string",
              "minLength": 1
            },
            "kind": {
              "const": "leave_one_donor_out"
            },
            "donor_id": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "spec_id",
            "rationale",
            "kind",
            "donor_id"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "spec_id": {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,79}$"
            },
            "rationale": {
              "type": "string",
              "minLength": 1
            },
            "kind": {
              "const": "method"
            },
            "analysis_spec": {
              "type": "object",
              "properties": {
                "method": {
                  "type": "string",
                  "minLength": 1
                },
                "version": {
                  "type": "string",
                  "minLength": 1
                },
                "normalization": {
                  "type": "string",
                  "minLength": 1
                },
                "test": {
                  "type": "string",
                  "minLength": 1
                },
                "p_adjustment": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "required": [
                "method",
                "version",
                "normalization",
                "test",
                "p_adjustment"
              ],
              "additionalProperties": false
            }
          },
          "required": [
            "spec_id",
            "rationale",
            "kind",
            "analysis_spec"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "spec_id": {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,79}$"
            },
            "rationale": {
              "type": "string",
              "minLength": 1
            },
            "kind": {
              "const": "gene_filter"
            },
            "min_count": {
              "type": "integer",
              "minimum": 1,
              "maximum": 9007199254740991
            },
            "min_samples": {
              "type": "integer",
              "minimum": 1
            }
          },
          "required": [
            "spec_id",
            "rationale",
            "kind",
            "min_count",
            "min_samples"
          ],
          "additionalProperties": false
        }
      ]
    },
    "run": {
      "type": "object",
      "properties": {
        "schema_version": {
          "const": "bionexus.de-alternative-run.v1"
        },
        "contract": {
          "type": "object",
          "properties": {
            "path": {
              "type": "string",
              "minLength": 1
            },
            "sha256": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            }
          },
          "required": [
            "path",
            "sha256"
          ],
          "additionalProperties": false
        },
        "counts": {
          "type": "object",
          "properties": {
            "path": {
              "type": "string",
              "minLength": 1
            },
            "sha256": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            }
          },
          "required": [
            "path",
            "sha256"
          ],
          "additionalProperties": false
        },
        "cells": {
          "type": "object",
          "properties": {
            "path": {
              "type": "string",
              "minLength": 1
            },
            "sha256": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            }
          },
          "required": [
            "path",
            "sha256"
          ],
          "additionalProperties": false
        },
        "analysis_spec": {
          "type": "object",
          "properties": {
            "method": {
              "type": "string",
              "minLength": 1
            },
            "version": {
              "type": "string",
              "minLength": 1
            },
            "normalization": {
              "type": "string",
              "minLength": 1
            },
            "test": {
              "type": "string",
              "minLength": 1
            },
            "p_adjustment": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "method",
            "version",
            "normalization",
            "test",
            "p_adjustment"
          ],
          "additionalProperties": false
        },
        "synthetic": {
          "type": "boolean"
        }
      },
      "required": [
        "schema_version",
        "contract",
        "counts",
        "cells",
        "analysis_spec",
        "synthetic"
      ],
      "additionalProperties": false
    },
    "plan": {
      "type": "object",
      "properties": {
        "schema_version": {
          "const": "bionexus.de-alternative-plan.v1"
        },
        "baseline": {
          "type": "object",
          "properties": {
            "path": {
              "type": "string",
              "minLength": 1
            },
            "sha256": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            }
          },
          "required": [
            "path",
            "sha256"
          ],
          "additionalProperties": false
        },
        "specifications": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/specification"
          }
        },
        "synthetic": {
          "type": "boolean"
        },
        "claim_contract_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "selection_timing": {
          "const": "NOT_VERIFIED"
        },
        "scientific_admissibility": {
          "const": "REQUIRES_REVIEW"
        }
      },
      "required": [
        "schema_version",
        "baseline",
        "specifications",
        "synthetic",
        "claim_contract_sha256",
        "selection_timing",
        "scientific_admissibility"
      ],
      "additionalProperties": false
    },
    "results": {
      "type": "object",
      "properties": {
        "schema_version": {
          "const": "bionexus.de-alternative-results.v1"
        },
        "plan_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "runs": {
          "type": "array",
          "items": {
            "oneOf": [
              {
                "type": "object",
                "properties": {
                  "spec_id": {
                    "type": "string",
                    "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,79}$"
                  },
                  "status": {
                    "const": "completed"
                  },
                  "record": {
                    "type": "object",
                    "properties": {
                      "path": {
                        "type": "string",
                        "minLength": 1
                      },
                      "sha256": {
                        "type": "string",
                        "pattern": "^[a-f0-9]{64}$"
                      }
                    },
                    "required": [
                      "path",
                      "sha256"
                    ],
                    "additionalProperties": false
                  }
                },
                "required": [
                  "spec_id",
                  "status",
                  "record"
                ],
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {
                  "spec_id": {
                    "type": "string",
                    "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,79}$"
                  },
                  "status": {
                    "enum": [
                      "pending",
                      "failed"
                    ]
                  },
                  "reason": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "required": [
                  "spec_id",
                  "status",
                  "reason"
                ],
                "additionalProperties": false
              }
            ]
          }
        }
      },
      "required": [
        "schema_version",
        "plan_sha256",
        "runs"
      ],
      "additionalProperties": false
    }
  }
}
