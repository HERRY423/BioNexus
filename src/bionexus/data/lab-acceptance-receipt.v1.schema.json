{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bionexus.dev/schemas/lab-acceptance-receipt.v1",
  "title": "BioNexus local file roundtrip acceptance receipt",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "created_at", "bionexus_version", "passed", "product", "source", "output_dir", "gates", "scientific_authorization", "data_classification", "receipt_path", "scope", "producer_version_verification", "official_profile_conformance", "implementation_sha256", "artifact_sha256"],
  "properties": {
    "schema_version": {"const": "bionexus.lab-acceptance-receipt.v1"},
    "created_at": {"type": "string", "minLength": 1},
    "bionexus_version": {"type": "string", "minLength": 1},
    "passed": {"type": "boolean"},
    "product": {"type": "string"},
    "source": {"type": "string"},
    "output_dir": {"type": "string"},
    "gates": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["name", "passed", "detail"],
        "properties": {"name": {"type": "string"}, "passed": {"type": "boolean"}, "detail": {"type": "string"}}
      }
    },
    "envelope_path": {"type": ["string", "null"]},
    "capsule_path": {"type": ["string", "null"]},
    "ro_crate_path": {"type": ["string", "null"]},
    "bco_path": {"type": ["string", "null"]},
    "receipt_path": {"type": "string", "minLength": 1},
    "scientific_authorization": {"const": "NONE"},
    "data_classification": {"enum": ["UNKNOWN", "PUBLIC_BENCHMARK", "PROPRIETARY_UNPUBLISHED", "CONTROLLED_ACCESS_GENOMIC", "RESTRICTED_CLINICAL_PHI"]},
    "scope": {"const": "LOCAL_FILE_ROUNDTRIP_ONLY"},
    "producer_version_verification": {"const": "NOT_ASSESSED"},
    "official_profile_conformance": {"const": "NOT_ASSESSED"},
    "implementation_sha256": {"type": "object", "minProperties": 1, "additionalProperties": {"type": "string", "pattern": "^[0-9a-f]{64}$"}},
    "artifact_sha256": {"type": "object", "additionalProperties": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}
  }
}
