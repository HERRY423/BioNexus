{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bionexus.org/schemas/evidence-attestation.v1.json",
  "title": "BioNexus target-bound evidence attestation",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "attestation_id", "predicate_type", "subject", "scope",
    "claims", "issued_at", "expires_at", "signer_id", "key_id",
    "signature_algorithm", "signature_b64"
  ],
  "properties": {
    "schema_version": {"const": "bionexus.evidence-attestation.v1"},
    "attestation_id": {"type": "string", "minLength": 1},
    "predicate_type": {"type": "string", "minLength": 1},
    "subject": {
      "type": "object",
      "additionalProperties": false,
      "required": ["subject_type", "subject_id", "version", "artifact_uri", "artifact_sha256"],
      "properties": {
        "subject_type": {"type": "string", "minLength": 1},
        "subject_id": {"type": "string", "minLength": 1},
        "version": {"type": "string", "minLength": 1},
        "artifact_uri": {"type": "string", "minLength": 1},
        "artifact_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    },
    "scope": {"type": "object"},
    "claims": {"type": "object"},
    "issued_at": {"type": "string", "format": "date-time"},
    "expires_at": {"type": ["string", "null"], "format": "date-time"},
    "signer_id": {"type": "string", "minLength": 1},
    "key_id": {"type": "string", "minLength": 1},
    "signature_algorithm": {"const": "Ed25519"},
    "signature_b64": {"type": "string", "minLength": 1}
  }
}
