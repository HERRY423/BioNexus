              "dataset_id": {
                "type": "string",
                "minLength": 1,
                "pattern": "\\S"
              },
              "role": {
                "enum": [
                  "discovery",
                  "holdout"
                ]
              },
              "identity_namespace": {
                "type": "string",
                "minLength": 1,
                "pattern": "\\S"
              },
              "manifest": {
                "type": "object",
                "properties": {
                  "path": {
                    "type": "string",
                    "minLength": 1,
                    "pattern": "\\S"
                  },
                  "sha256": {
                    "type": "string",
                    "pattern": "^[a-f0-9]{64}$"
                  }
                },
                "required": [
                  "path",
                  "sha256"
                ],
                "additionalProperties": false
              }
            },
            "required": [
              "dataset_id",
              "role",
              "identity_namespace",
              "manifest"
            ],
            "additionalProperties": false
          },
          "minItems": 0,
          "uniqueItems": false
        },
        "synthetic": {
          "type": "boolean"
        }
      },
      "required": [
        "scope_id",
        "actor_ids",
        "session_ids",
        "branch_inventory",
        "capture_mode",
        "coverage",
        "gaps",
        "datasets",
        "synthetic"
      ],
      "additionalProperties": false
    },
