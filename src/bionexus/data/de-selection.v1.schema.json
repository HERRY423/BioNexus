            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "minItems": 0,
          "uniqueItems": true
        },
        "capture_mode": {
          "enum": [
            "prospective",
            "retrospective",
            "unknown"
          ]
        },
        "coverage": {
          "enum": [
            "complete_declared",
            "partial",
            "unknown"
          ]
        },
        "gaps": {
          "type": "array",
