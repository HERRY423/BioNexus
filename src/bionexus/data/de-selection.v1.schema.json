{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Bounded declared DE selection history",
  "$defs": {
    "plan": {
      "type": "object",
      "properties": {
        "schema_version": {
          "const": "bionexus.de-selection-plan.v1"
        },
        "analysis": {
          "type": "object",
          "properties": {
            "cell_type": {
              "type": "string",
              "minLength": 1
            },
            "numerator": {
              "type": "string",
              "minLength": 1
            },
            "denominator": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "cell_type",
            "numerator",
            "denominator"
          ],
          "additionalProperties": false
        },
        "claims": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "claim_id": {
                "type": "string",
                "minLength": 1
              },
              "gene": {
                "type": "string",
                "minLength": 1
              },
              "direction": {
                "enum": [
                  "up",
                  "down"
                ]
              },
              "scope": {
                "enum": [
                  "table_observation",
                  "cohort_association",
                  "population_effect",
                  "causal_effect"
                ]
              },
              "alpha": {
                "type": "number",
                "exclusiveMinimum": 0,
                "exclusiveMaximum": 1
              }
            },
            "required": [
              "claim_id",
              "gene",
              "direction",
              "scope",
              "alpha"
            ],
            "additionalProperties": false
          },
          "minItems": 1
        },
        "metadata_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "model": {
          "type": "object",
          "properties": {
            "formula": {
              "type": "string",
              "minLength": 1,
              "pattern": "\\S"
            },
            "statistical_unit": {
              "enum": [
                "independent_donor",
                "paired_donor_fixed_effect"
              ]
            },
            "effect_measure": {
              "const": "log2_fold_change"
            }
          },
          "required": [
            "formula",
            "statistical_unit",
            "effect_measure"
          ],
          "additionalProperties": false
        },
        "selection_rule": {
          "const": "report_all_planned_claims"
        }
      },
      "required": [
        "schema_version",
        "analysis",
        "claims",
        "metadata_sha256",
        "model",
        "selection_rule"
      ],
      "additionalProperties": false
    },
    "manifest": {
      "type": "object",
      "properties": {
        "scope_id": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "actor_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "session_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "branch_inventory": {
          "type": "array",
