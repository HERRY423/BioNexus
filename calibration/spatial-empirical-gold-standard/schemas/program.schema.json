{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:bionexus:spatial-empirical-gold-program-schema:1",
  "type": "object",
  "required": ["schema_version", "program_version", "status", "capability_id", "supported_platforms", "platform_programs", "alternative_explanations", "policies", "studies", "approved_profiles"],
  "properties": {
    "$schema": {"type": "string"},
    "schema_version": {"const": "bionexus.spatial-empirical-gold-program.v1"},
    "program_version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "status": {"enum": ["incomplete_not_claim_ready", "candidate_only", "externally_validated"]},
    "capability_id": {"const": "spatial.inference_validity"},
    "scope": {"type": "string"},
    "supported_platforms": {"const": ["xenium", "cosmx", "merscope"]},
    "platform_programs": {"type": "object"},
    "alternative_explanations": {"type": "object", "minProperties": 1},
    "policies": {"type": "object"},
    "studies": {
      "type": "array",
      "items": {"$ref": "#/$defs/study"}
    },
    "approved_profiles": {
      "type": "array",
      "items": {"$ref": "#/$defs/approvedProfile"}
    }
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "studyBinding": {
      "type": "object",
      "required": [
        "study_id", "study_manifest_sha256", "observation_artifact_sha256",
        "observation_records_sha256", "artifact_verification_receipt_sha256"
      ],
      "properties": {
        "study_id": {"type": "string", "minLength": 1},
        "study_manifest_sha256": {"$ref": "#/$defs/sha256"},
        "observation_artifact_sha256": {"$ref": "#/$defs/sha256"},
        "observation_records_sha256": {"$ref": "#/$defs/sha256"},
        "artifact_verification_receipt_sha256": {"$ref": "#/$defs/sha256"}
      },
      "additionalProperties": false
    },
    "study": {
      "type": "object",
      "required": ["study_id", "platform", "manifest_uri", "manifest_sha256", "status"],
      "properties": {
        "study_id": {"type": "string", "minLength": 1},
        "platform": {"enum": ["xenium", "cosmx", "merscope"]},
        "manifest_uri": {"type": "string", "minLength": 1},
        "manifest_sha256": {"$ref": "#/$defs/sha256"},
        "status": {"enum": ["BYTE_VERIFIED", "SUSPENDED", "RETIRED"]}
      },
      "additionalProperties": false
    },
    "approvedProfile": {
      "type": "object",
      "required": [
        "profile_id", "version", "profile_sha256", "profile_artifact_uri",
        "profile_artifact_sha256", "platform", "metric", "study_bindings",
        "approval_attestation_id", "status"
      ],
      "properties": {
        "profile_id": {"type": "string", "minLength": 1},
        "version": {"type": "string", "minLength": 1},
        "profile_sha256": {"$ref": "#/$defs/sha256"},
        "profile_artifact_uri": {"type": "string", "minLength": 1},
        "profile_artifact_sha256": {"$ref": "#/$defs/sha256"},
        "platform": {"enum": ["xenium", "cosmx", "merscope"]},
        "metric": {"type": "string", "minLength": 1},
        "study_bindings": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/studyBinding"}
        },
        "approval_attestation_id": {"type": "string", "minLength": 1},
        "status": {"enum": ["ACTIVE", "SUSPENDED", "RETIRED"]}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
