{
  "name": "Main review and scientific checks",
  "target": "branch",
  "enforcement": "active",
  "conditions": {
    "ref_name": {
      "include": [
        "refs/heads/main"
      ],
      "exclude": []
    }
  },
  "rules": [
    {
      "type": "pull_request",
      "parameters": {
        "required_approving_review_count": 1,
        "dismiss_stale_reviews_on_push": true,
        "require_last_push_approval": true,
        "require_code_owner_review": false,
        "required_review_thread_resolution": false
      }
    },
    {
      "type": "required_status_checks",
      "parameters": {
        "strict_required_status_checks_policy": true,
        "required_status_checks": [
          {
            "context": "Core Types, Branch Coverage & DE Requirement Evidence",
            "integration_id": 15368
          },
          {
            "context": "Flagship Data, Evidence & Strict Benchmark",
            "integration_id": 15368
          },
          {
            "context": "Canonical Scientific Stack (ubuntu-latest, Python 3.12)",
            "integration_id": 15368
          },
          {
            "context": "Canonical Scientific Stack (macos-latest, Python 3.12)",
            "integration_id": 15368
          },
          {
            "context": "Canonical Scientific Stack (windows-latest, Python 3.12)",
            "integration_id": 15368
          }
        ]
      }
    }
  ]
}
