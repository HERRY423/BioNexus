# ==============================================================================
# BioNexus Plugin: API Keys & Environment Configuration
# ==============================================================================
# Copy this file to `.env` in the plugin root or your workspace root.
# Core databases (PubMed, bioRxiv, ChEMBL, Open Targets, ClinicalTrials) work
# out-of-the-box without keys. Adding keys enables higher rate limits and
# organization-specific platforms.
# ==============================================================================

# [Optional] NCBI PubMed E-utilities API Key
# Increases request limit from 3 req/s to 10 req/s
# Get free key at: https://www.ncbi.nlm.nih.gov/account/settings/
NCBI_API_KEY=

# [Optional] Benchling LIMS / ELN Platform Configuration
# Connects to your organization's internal sample registry & electronic lab notebook
BENCHLING_API_KEY=
BENCHLING_TENANT=https://your-org.benchling.com

# [Optional] Sage Bionetworks Synapse Token
# Access private/shared datasets & DREAM challenges: https://www.synapse.org/#!PersonalAccessTokens:
SYNAPSE_AUTH_TOKEN=

# [Optional] Academic Publishers & AI Research
WILEY_API_KEY=
CONSENSUS_API_KEY=
OWKIN_API_KEY=
BIORENDER_API_KEY=
