Bootstrap: docker
From: python@sha256:0bee7276f83efd4a1ee05bbbf4281d95ed28e079220a9457f25a93e3f1e3c31b
# ^ python:3.11-slim-bookworm, multi-arch OCI index digest, pinned 2026-08-30.
#   A rebuilt image resolves the same base; CI re-verifies the digest
#   (see DEPLOYMENT_MANIFEST.json and .github/workflows/container.yml).

%help
    BioNexus scientific reliability layer — full scientific stack image for
    HPC clusters (Apptainer/Singularity). Lab-grade deployment profile.

    Reproducibility: the base image is pinned by digest and every Python
    dependency is installed from container/requirements-lock.txt (exact
    versions + SHA-256 wheel hashes), so a rebuild months later yields the
    same stack. Supply chain: container/sbom-python.json is the CycloneDX
    SBOM of the locked stack; container/DEPLOYMENT_MANIFEST.json records
    digests and evidence status.

    Offline / air-gapped operation: set BIONEXUS_OFFLINE=1 to force the
    OFFLINE_STRICT egress mode (zero hosted endpoints). Verify with:
        apptainer exec bionexus.sif bionexus offline-check --enforce

    GPU profile: the same SIF serves CPU and GPU nodes. The Linux torch
    build ships CUDA support; on a GPU node run with the driver injection
    flag and Slurm allocates the device:
        apptainer exec --nv bionexus.sif bionexus doctor
    (see cluster/slurm/profiles/hpc-gpu.sbatch).

    Verify after pulling/building:
        apptainer exec bionexus.sif bionexus doctor --json
        apptainer exec bionexus.sif bionexus offline-check --enforce

    Run on a cluster (bind a writable work dir for outputs):
        apptainer exec --bind /scratch:/scratch bionexus.sif \
            bionexus preflight /scratch/cohort.h5ad --intent differential-expression

    Scope: scientific-matrix dependency set (scanpy, squidpy, pydeseq2,
    lifelines, allotropy; torch works on CPU and, with --nv, on GPU nodes).
    The image is Research Use Only.

%labels
    org.opencontainers.image.title BioNexus
    org.opencontainers.image.description Scientific reliability layer for AI-assisted biology (RUO)
    org.opencontainers.image.licenses Apache-2.0
    org.opencontainers.image.source https://github.com/HERRY423/BioNexus
    org.opencontainers.image.base.name docker.io/library/python:3.11-slim-bookworm
    org.opencontainers.image.base.digest sha256:0bee7276f83efd4a1ee05bbbf4281d95ed28e079220a9457f25a93e3f1e3c31b
    org.bionexus.deployment.lockfile-sha256 e121e9df13c38316ef5f79ff9b0336508af3f4aba5bc4f2b5a593893758ed0d0
    org.bionexus.deployment.sbom-sha256 059e6e05b948d35863e3380477690883959d43e129474105968c18dc2e6f910f

%environment
    # Keep matplotlib headless inside containers and batch jobs.
    export MPLBACKEND=Agg
    export PYTHONUNBUFFERED=1

%files
    pyproject.toml /opt/bionexus/pyproject.toml
    README.md /opt/bionexus/README.md
    LICENSE /opt/bionexus/LICENSE
    src /opt/bionexus/src
    skills /opt/bionexus/skills
    scripts /opt/bionexus/scripts
    evals /opt/bionexus/evals
    container/requirements-lock.txt /opt/bionexus/container/requirements-lock.txt
    container/sbom-python.json /opt/bionexus/container/sbom-python.json

%post
    export DEBIAN_FRONTEND=noninteractive
    apt-get update && apt-get install -y --no-install-recommends \
        git build-essential procps && \
        rm -rf /var/lib/apt/lists/*

    python -m pip install --no-cache-dir --upgrade pip
    cd /opt/bionexus
    # 1. Locked scientific stack: exact versions + wheel hashes (hash-checking
    #    mode is automatic because the lockfile carries --hash entries), so a
    #    tampered or drifted wheel fails the build instead of installing.
    python -m pip install --no-cache-dir -r container/requirements-lock.txt
    # 2. The source tree itself (no deps: everything came from the lockfile).
    python -m pip install --no-cache-dir --no-deps -e .

    # Fail the build when the scientific stack is not importable or the CLI
    # entry points are broken — a broken image must not exist.
    python - <<'PY'
from bionexus.doctor import run_doctor
report = run_doctor()
ready = report.get("ready", {})
required = ["core_ready", "scverse_ready", "spatial_ready", "survival_ready"]
missing = [name for name in required if not ready.get(name)]
assert not missing, f"image self-check failed, missing backends: {missing}"
print("image self-check OK; backends:", ", ".join(sorted(k for k, v in ready.items() if v)))
PY

%test
    python -c "import scanpy, squidpy, pydeseq2, lifelines; print('scientific stack importable')"
    bionexus doctor --json > /dev/null && echo "doctor OK"
    bionexus offline-check --enforce && echo "offline deployment gate OK"
    bionexus preflight --help > /dev/null && echo "preflight entry point OK"
    bionexus audit --help > /dev/null && echo "audit entry point OK"
    bionexus verify --help > /dev/null && echo "verify entry point OK"

%runscript
    exec bionexus "$@"
